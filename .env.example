PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# General Rate Limit Settings
RATE_LIMIT_ALGORITHM=token-bucket
RATE_LIMIT_TTL_SECONDS=3600

# Window-based algorithms (fixed-window, sliding-window-log, sliding-window-counter)
RATE_LIMIT_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# Token bucket specific
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_RATE=1

# Leaky bucket specific
LEAKY_BUCKET_CAPACITY=10
LEAKY_BUCKET_LEAK_RATE=1

# GCRA specific
GCRA_EMISSION_INTERVAL=100
GCRA_BURST_CAPACITY=10

